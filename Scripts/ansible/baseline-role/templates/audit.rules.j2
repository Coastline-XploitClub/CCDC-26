# Remove any existing rules
-D

# Buffer Size
## Feel free to increase this if the machine panic's
-b 8192

# Failure Mode
## Possible values: 0 (silent), 1 (printk, print a failure message), 2 (panic, halt the system)
-f 1

# Ignore errors
## e.g. caused by users or files not found in the local environment
-i

# Self Auditing ---------------------------------------------------------------

## Audit the audit logs
### Successful and unsuccessful attempts to read information from the audit records
-w /var/log/audit/ -p wra -k tampering
-w /var/audit/ -p wra -k tampering

## Auditd configuration
### Modifications to audit configuration that occur while the audit collection functions are operating
-w /etc/audit/ -p wa -k tampering
-w /etc/libaudit.conf -p wa -k tampering
-w /etc/audisp/ -p wa -k tampering


# Filters ---------------------------------------------------------------------

### We put these early because audit is a first match wins system.

## Ignore current working directory records
-a always,exclude -F msgtype=CWD

## Cron jobs fill the logs with stuff we normally don't want (works with SELinux)
-a never,user -F subj_type=crond_t
-a never,exit -F subj_type=crond_t

## This prevents chrony from overwhelming the logs
-a never,exit -F arch=b64 -S adjtimex -F auid=-1 -F uid=chrony -F subj_type=chronyd_t

## This is not very interesting and wastes a lot of space if the server is public facing
-a always,exclude -F msgtype=CRYPTO_KEY_USER

## VM Tools
-a exit,never -F arch=b64 -S all -F exe=/usr/bin/vmtoolsd
-a exit,never -F arch=b64 -S all -F exe=/usr/bin/qemu-ga

## High Volume Event Filter (especially on Linux Workstations)
-a never,exit -F arch=b32 -F dir=/dev/shm/ -F key=sharedmemaccess
-a never,exit -F arch=b64 -F dir=/dev/shm/ -F key=sharedmemaccess

-a never,exit -F arch=b32 -F dir=/var/lock/lvm/ -F key=locklvm
-a never,exit -F arch=b64 -F dir=/var/lock/lvm/ -F key=locklvm

## More information on how to filter events
### https://access.redhat.com/solutions/2482221

# Rules -----------------------------------------------------------------------

## Kernel parameters
-w /etc/sysctl.conf -p wa -k services
-w /etc/sysctl.d -p wa -k services

## Kernel module loading and unloading
-a always,exit -F perm=x -F auid!=-1 -F path=/sbin/insmod -k modules
-a always,exit -F perm=x -F auid!=-1 -F path=/sbin/modprobe -k modules
-a always,exit -F perm=x -F auid!=-1 -F path=/sbin/rmmod -k modules
-a always,exit -F arch=b64 -S finit_module -S init_module -S delete_module -F auid!=-1 -k modules
-w /etc/modprobe.conf -p wa -k modules
-w /etc/modprobe.d -p wa -k modules

## Stunnel
-w /usr/sbin/stunnel -p x -k medium
-w /usr/bin/stunnel -p x -k medium

## Modification of cron rules
-w /etc/cron.allow -p wa -k high
-w /etc/cron.deny -p wa -k high
-w /etc/cron.d/ -p wa -k high
-w /etc/cron.daily/ -p wa -k high
-w /etc/cron.hourly/ -p wa -k high
-w /etc/cron.monthly/ -p wa -k high
-w /etc/cron.weekly/ -p wa -k high
-w /etc/crontab -p wa -k high
-w /var/spool/cron/ -p wa -k high

## User, group, password changes
-w /etc/group -p wa -k high
-w /etc/passwd -p wa -k high
-w /etc/gshadow -k high
-w /etc/shadow -k high
-w /etc/security/opasswd -k high

## Use of passwd command
-w /usr/bin/passwd -p x -k high

## Sudoers file changes
-w /etc/sudoers -p wa -k high
-w /etc/sudoers.d/ -p wa -k high

## Tools to change group identifiers
-w /usr/sbin/groupadd -p x -k high
-w /usr/sbin/groupmod -p x -k high
-w /usr/sbin/addgroup -p x -k high
-w /usr/sbin/useradd -p x -k high
-w /usr/sbin/userdel -p x -k high
-w /usr/sbin/usermod -p x -k high
-w /usr/sbin/adduser -p x -k high

### Detect Remote Shell Use
-a always,exit -F arch=b64 -F exe=/bin/bash -F success=1 -S connect -k high
-a always,exit -F arch=b64 -F exe=/usr/bin/bash -F success=1 -S connect -k high

### Changes to other files
-w /etc/hosts -p wa -k high
-w /etc/sysconfig/network -p wa -k high
-w /etc/sysconfig/network-scripts -p w -k high
-w /etc/network/ -p wa -k high
-a always,exit -F dir=/etc/NetworkManager/ -F perm=wa -k high

## System startup scripts
-w /etc/inittab -p wa -k medium
-w /etc/init.d/ -p wa -k medium
-w /etc/init/ -p wa -k medium

## Pam configuration
-w /etc/pam.d/ -p wa -k low
-w /etc/security/limits.conf -p wa  -k low
-w /etc/security/limits.d -p wa  -k low
-w /etc/security/pam_env.conf -p wa -k low
-w /etc/security/namespace.conf -p wa -k low
-w /etc/security/namespace.d -p wa -k low
-w /etc/security/namespace.init -p wa -k low

## SSH configuration
-w /etc/ssh/sshd_config -k high
-w /etc/ssh/sshd_config.d -k high

## root/admin ssh key tampering
-w /root/.ssh -p wa -k high
-w /home/{{ admin_user }}/.ssh -p wa -k high

# Systemd
-w /bin/systemctl -p x -k systemd
-w /etc/systemd/ -p wa -k systemd
-w /usr/lib/systemd -p wa -k systemd

## Critical elements access failures
-a always,exit -F arch=b64 -S open -F dir=/etc -F success=0 -k low
-a always,exit -F arch=b64 -S open -F dir=/bin -F success=0 -k low
-a always,exit -F arch=b64 -S open -F dir=/sbin -F success=0 -k low
-a always,exit -F arch=b64 -S open -F dir=/usr/bin -F success=0 -k low
-a always,exit -F arch=b64 -S open -F dir=/usr/sbin -F success=0 -k low
-a always,exit -F arch=b64 -S open -F dir=/var -F success=0 -k low
-a always,exit -F arch=b64 -S open -F dir=/home -F success=0 -k low
-a always,exit -F arch=b64 -S open -F dir=/srv -F success=0 -k low

## Process ID change (switching accounts) applications
-w /bin/su -p x -k sudo
-w /usr/bin/sudo -p x -k sudo

# Enable an audit context for any linking operation, such as symlink, link, unlink, or rename.
-a always,exit -F arch=b64 -S unlink -S rename -S link -S symlink  -k high
-a always,exit -F arch=b32 -S unlink -S rename -S link -S symlink  -k high

## Power state
-w /sbin/shutdown -p x -k medium
-w /sbin/poweroff -p x -k medium
-w /sbin/reboot -p x -k medium
-w /sbin/halt -p x -k medium

## Session initiation information
-w /var/run/utmp -p wa -k session
-w /var/log/btmp -p wa -k session
-w /var/log/wtmp -p wa -k session

## Discretionary Access Control (DAC) modifications
-a always,exit -F arch=b64 -S chmod  -F auid>=1000 -F auid!=-1 -k perms
-a always,exit -F arch=b64 -S chown -F auid>=1000 -F auid!=-1 -k perms
-a always,exit -F arch=b64 -S fchmod -F auid>=1000 -F auid!=-1 -k perms
-a always,exit -F arch=b64 -S fchmodat -F auid>=1000 -F auid!=-1 -k perms
-a always,exit -F arch=b64 -S fchown -F auid>=1000 -F auid!=-1 -k perms
-a always,exit -F arch=b64 -S fchownat -F auid>=1000 -F auid!=-1 -k perms
-a always,exit -F arch=b64 -S fremovexattr -F auid>=1000 -F auid!=-1 -k perms
-a always,exit -F arch=b64 -S fsetxattr -F auid>=1000 -F auid!=-1 -k perms
-a always,exit -F arch=b64 -S lchown -F auid>=1000 -F auid!=-1 -k perms
-a always,exit -F arch=b64 -S lremovexattr -F auid>=1000 -F auid!=-1 -k perms
-a always,exit -F arch=b64 -S lsetxattr -F auid>=1000 -F auid!=-1 -k perms
-a always,exit -F arch=b64 -S removexattr -F auid>=1000 -F auid!=-1 -k perms
-a always,exit -F arch=b64 -S setxattr -F auid>=1000 -F auid!=-1 -k perms

# Special Rules ---------------------------------------------------------------

# watch forks and network activity under key ps
-a always,exit -F arch=b64 -S execve -S vfork -S fork -S clone -S exit -S exit_group -S connect -S bind -S sendto -k ps
-a always,exit -F arch=b32 -S execve -S vfork -S fork -S clone -S exit -S exit_group -S socketcall -k ps

## Reconnaissance
-w /usr/bin/whoami -p x -k low
-w /usr/bin/id -p x -k low
-w /bin/hostname -p x -k low
-w /bin/uname -p x -k low
-w /etc/issue -p r -k low
-w /etc/hostname -p r -k low

## Suspicious activity
-w /usr/bin/wget -F uid!={{ admin_user }} -p x -k bins
-w /usr/bin/curl -F uid!={{ admin_user }} -p x -k bins
-w /usr/bin/base64 -F uid!={{ admin_user }} -p x -k bins
-w /bin/nc -F uid!={{ admin_user }} -p x -k bins
-w /bin/netcat -F uid!={{ admin_user }} -p x -k bins
-w /usr/bin/ncat -F uid!={{ admin_user }} -p x -k bins
-w /usr/bin/ss -F uid!={{ admin_user }} -p x -k bins
-w /usr/bin/netstat -F uid!={{ admin_user }} -p x -k bins
-w /usr/bin/ssh -F uid!={{ admin_user }} -p x -k bins
-w /usr/bin/scp -F uid!={{ admin_user }} -p x -k bins
-w /usr/bin/sftp -F uid!={{ admin_user }} -p x -k bins
-w /usr/bin/ftp -F uid!={{ admin_user }} -p x -k bins
-w /usr/bin/socat -F uid!={{ admin_user }} -p x -k bins
-w /usr/bin/wireshark -F uid!={{ admin_user }} -p x -k bins
-w /usr/bin/tshark -F uid!={{ admin_user }} -p x -k bins
-w /usr/bin/rawshark -F uid!={{ admin_user }} -p x -k bins
-w /usr/bin/rdesktop -F uid!={{ admin_user }} -p x -k bins
-w /usr/local/bin/rdesktop -F uid!={{ admin_user }} -p x -k bins
-w /usr/bin/wlfreerdp -F uid!={{ admin_user }} -p x -k bins
-w /usr/bin/xfreerdp -F uid!={{ admin_user }} -p x -k bins
-w /usr/local/bin/xfreerdp -F uid!={{ admin_user }} -p x -k bins

## Firewall rules
-w /sbin/iptables -F uid!={{ admin_user }} -p x -k medium
-w /sbin/ip6tables -F uid!={{ admin_user }} -p x -k medium
-w /sbin/ifconfig -F uid!={{ admin_user }} -p x -k medium
-w /usr/sbin/arptables -F uid!={{ admin_user }} -p x -k medium
-w /usr/sbin/ebtables -F uid!={{ admin_user }} -p x -k medium
-w /sbin/xtables-nft-multi -F uid!={{ admin_user }} -p x -k medium
-w /usr/sbin/nft -F uid!={{ admin_user }} -p x -k medium
-w /usr/sbin/tcpdump -F uid!={{ admin_user }} -p x -k medium
-w /usr/sbin/ufw -F uid!={{ admin_user }} -p x -k medium

# Web Server Activity
## Change the number "33" to the ID of your WebServer user. Default: www-data:x:33:33
-a always,exit -F arch=b64 -S execve -F euid=33 -k detect_execve_www

## Shell/profile configurations
-w /etc/profile.d/ -p wa -k medium
-w /etc/profile -p wa -k medium
-w /etc/shells -p wa -k medium
-w /etc/bashrc -p wa -k medium
-w /etc/csh.cshrc -p wa -k medium
-w /etc/csh.login -p wa -k medium
-w /etc/fish/ -p wa -k medium
-w /etc/zsh/ -p wa -k medium

## Injection
### These rules watch for code injection by the ptrace facility.
### This could indicate someone trying to do something bad or just debugging
-a always,exit -F arch=b64 -S ptrace -F a0=0x4 -k medium
-a always,exit -F arch=b64 -S ptrace -F a0=0x5 -k medium
-a always,exit -F arch=b64 -S ptrace -F a0=0x6 -k medium
-a always,exit -F arch=b64 -S ptrace -k medium

## Privilege Abuse
### The purpose of this rule is to detect when an admin may be abusing power by looking in user's home dir.
-a always,exit -F dir=/home -F uid=0 -F auid>=1000 -F auid!=-1 -C auid!=obj_uid -k low

# Software Management ---------------------------------------------------------

# RPM (Redhat/CentOS)
-w /usr/bin/rpm -p x -k software_mgmt
-w /usr/bin/yum -p x -k software_mgmt

# DNF (Fedora/RedHat 8/CentOS 8)
-w /usr/bin/dnf -p x -k software_mgmt

# YAST/Zypper/RPM (SuSE)
-w /sbin/yast -p x -k software_mgmt
-w /sbin/yast2 -p x -k software_mgmt
-w /bin/rpm -p x -k software_mgmt
-w /usr/bin/zypper -k software_mgmt

# DPKG / APT-GET (Debian/Ubuntu)
-w /usr/bin/dpkg -p x -k software_mgmt
-w /usr/bin/apt -p x -k software_mgmt
-w /usr/bin/apt-add-repository -p x -k software_mgmt
-w /usr/bin/apt-get -p x -k software_mgmt
-w /usr/bin/aptitude -p x -k software_mgmt
-w /usr/bin/wajig -p x -k software_mgmt
-w /usr/bin/snap -p x -k software_mgmt

# PIP(3) (Python installs)
