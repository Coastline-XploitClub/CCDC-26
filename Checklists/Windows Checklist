#Full Script: Detailed Current Logon Sessions
# Function to parse "query user" output into objects
function Get-UserSessions {
    $sessions = query user 2>$null
    if (-not $sessions) {
        Write-Host "No session information available or access denied." -ForegroundColor Yellow
        return
    }

    $results = @()
    foreach ($line in $sessions[1..($sessions.Count - 1)]) {
        $parsed = $line -replace '\s{2,}', ',' | ConvertFrom-Csv -Header 'UserName','SessionName','ID','State','IdleTime','LogonTime'
        $results += $parsed
    }
    return $results
}

# Function to get extra info from WMI
function Get-LoggedOnUsers {
    Get-CimInstance -ClassName Win32_LoggedOnUser | ForEach-Object {
        $user = ($_.Antecedent -split '"')[1]
        $session = ($_.Dependent -split '"')[1]
        [PSCustomObject]@{
            User     = $user
            Session  = $session
        }
    } | Sort-Object User -Unique
}

# Combine both sources
$sessionInfo = Get-UserSessions
$userInfo = Get-LoggedOnUsers

# Join and display info
Write-Host "`n=== CURRENTLY LOGGED-ON USERS ===`n" -ForegroundColor Cyan
$sessionInfo | Format-Table UserName, SessionName, ID, State, IdleTime, LogonTime -AutoSize

Write-Host "`n=== ADDITIONAL LOGON CONTEXT (Win32_LoggedOnUser) ===`n" -ForegroundColor Cyan
$userInfo | Format-Table User, Session -AutoSize



