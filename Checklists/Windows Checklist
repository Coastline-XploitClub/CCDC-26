net user /domain

#Display drives
fsutil fsinfo drives

#Display Shares
net share

#Display Local Session
net session

#Enumerate Services (PowerShell)
Get-Service | Where-Object {$_.Status -eq "Running"} | Select-Object Name, DisplayName

#Enumerate Services and save it into CSV file. 
Get-Service | Where-Object {$_.Status -eq "Running"} | 
Select-Object Name, DisplayName, StartType |
Export-Csv -Path "C:\RunningServices.csv" -NoTypeInformation

# To get Service Status
Get-Service -Name <nameofservice>

#Stop Service
Stop-Service -Name <nameofservice>

#Start Service
Start-Service -name <nameofservice>
Get-Service | Out-File “C:\logs\All_Services.txt”

#Look For Open Ports
Get-NetTCPConnection | Where-Object {$_.State -eq "Listen"} | Select-Object LocalAddress, LocalPort, OwningProcess

#List and Save the Open Ports into a CSV file on C:\
Get-NetTCPConnection | Where-Object {$_.State -eq "Listen"} |
    Select-Object LocalAddress, LocalPort, State, @{Name="ProcessName";Expression={ (Get-Process -Id $_.OwningProcess).ProcessName }}, InterfaceAlias, CreationTime |
    Export-Csv -Path "C:\ListeningTCPConnections.csv" -NoTypeInformation

